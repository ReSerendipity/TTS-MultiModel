# EditorConfig — project-wide coding style
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{js,ts,tsx,jsx,json,yml,yaml,html,css,scss,vue}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.md]
# markdown 行尾两空格是硬换行语法，不能去
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
