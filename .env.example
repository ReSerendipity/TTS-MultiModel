# =============================================================================
# TTS_MultiModel — Environment Variables for Sensitive Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# The .env file is automatically loaded by config.py at startup.
# System environment variables always take precedence over .env entries.
#
# P1 安全修复：.env 中的旧 VAPID 私钥已被视为已污染并废弃。
# 如需使用 Web Push 通知功能，请自行生成新的密钥对：
#   python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); v.save_key('vapid_private.pem'); v.save_public_key('vapid_public.pem')"
# 生成后仅将公钥放入 .env，私钥文件应存放在安全的密钥管理系统中。
# pre-commit 已配置禁止提交包含 PRIVATE KEY 标记的文件。
# =============================================================================

# VAPID keys (OPTIONAL — only needed if you enable Web Push notifications)
# P1 安全修复：请勿在此放置真实私钥。仅放置公钥或占位符。
# VAPID_PUBLIC_KEY=your-public-key-here
# VAPID_PRIVATE_KEY_FILE=/path/to/secure/keyfile  # 私钥文件路径，不直接放入 .env

# =============================================================================
# 日志配置（环境变量覆盖，优先级高于 config.yaml）
# =============================================================================
# 运行环境：development / production / test
ENVIRONMENT=development

# 日志级别：DEBUG / INFO / WARNING / ERROR
# 生产环境建议 INFO 及以上，禁止输出 DEBUG 调试日志
LOG_LEVEL=INFO

# 日志文件路径（默认 <项目根>/logs/app.log）
LOG_PATH=logs/app.log
