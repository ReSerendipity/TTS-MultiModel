# 统一 UTF-8 + LF 行尾，防止跨平台编码损坏（2026-08 乱码事故后新增）
* text=auto

# 源码与文本文件强制 UTF-8 + LF
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.mp3  binary
*.wav  binary
*.mp4  binary
*.db   binary
*.sqlite binary

# 治理文件自身固定 LF：让 gitignore / mailmap / attributes 在各平台 checkout 后字节一致。
# 注：旧注释写的是"CRLF working copy creates a catch-all ignore rule"，实测复现不出来
# （git 2.55.0.windows.3 / core.autocrlf=true：模式行带 \r 时 git 会剥掉 CR，
# `/model/`、`outputs/`、`*.tmp` 与 negation 行的行为与 LF 版逐条一致）。留这条的理由换成
# "字节一致便于审计与 diff"，而不是修一个不存在的 catch-all bug —— 见 #74 处置记录。
/.gitignore text eol=lf
/.gitattributes text eol=lf
/.mailmap text eol=lf
Dockerfile text eol=lf
